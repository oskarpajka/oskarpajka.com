// Cloudflare Workers, static assets only: no server code runs.
// Deploy: npm run build, then npx wrangler deploy (see docs/DEPLOY.md).
{
  "name": "oskarpajka-com",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // No request logs are kept (the privacy policy says I only see totals).
  "observability": { "enabled": false },
  "routes": [
    { "pattern": "oskarpajka.com", "custom_domain": true }
  ]
}
