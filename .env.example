# Copy to .env to change these locally. Nothing here is secret.

# Where the films are served from. Default: https://media.oskarpajka.com
# To test with the files in media/web: npx http-server media/web -p 4400 --cors
# and set PUBLIC_MEDIA_BASE=http://localhost:4400
PUBLIC_MEDIA_BASE=

# Only if Cloudflare Web Analytics does not inject its script by itself:
# the token from Web Analytics > Manage site > JS snippet.
PUBLIC_CF_BEACON_TOKEN=
