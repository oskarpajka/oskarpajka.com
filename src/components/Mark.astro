---
// A marker tag that writes itself on. The SVG in public/marks/ is drawn as it is;
// a mask of traced brush strokes (src/data/strokes.json) uncovers it. Each stroke is
// cut into short segments, each wide enough for every pixel nearest to it, so the
// strokes alone cover the whole tag. The rect at the end is only a safety net.
import strokes from '../data/strokes.json';
import { timeMark } from '../lib/mark-timing.mjs';

type Name = keyof typeof strokes;

interface Props {
  name: Name;
  // 'load' writes on page load, 'view' when scrolled into view. Both are simply shown
  // without JavaScript. 'manual' starts hidden and the page script draws it.
  play?: 'load' | 'view' | 'manual';
  // 'written': one stroke after another, in painting order, over `dur` ms.
  // 'letters': the letters start in a shuffled order, `stagger` ms apart, and overlap;
  // each letter takes about `dur` ms.
  order?: 'written' | 'letters';
  dur?: number;
  stagger?: number;
  delay?: number;
  tall?: boolean; // oskar-wide turned a quarter, for the phone footer
  stretch?: boolean; // fill the box, like the circle around the email
  label?: string;
  class?: string;
  style?: string;
}

const {
  name,
  play = 'view',
  order = 'written',
  dur = 1200,
  stagger = 110,
  delay = 0,
  tall = false,
  stretch = false,
  label,
  class: cls,
  style,
} = Astro.props;
const mark = strokes[name];
const id = `mark-${name}-${Math.random().toString(36).slice(2, 8)}`;
const { timed, end } = timeMark(mark, { name, order, dur, stagger, delay });

const { w, h } = mark;
const viewBox = tall ? `0 0 ${h} ${w}` : `0 0 ${w} ${h}`;
const turn = tall ? `translate(0 ${w}) rotate(-90)` : undefined;
---

<svg
  class:list={['mark', cls]}
  viewBox={viewBox}
  preserveAspectRatio={stretch ? 'none' : undefined}
  data-mark={play}
  data-state={play === 'manual' ? 'armed' : undefined}
  style={style}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false">
  <defs>
    <mask id={id} maskUnits="userSpaceOnUse" x="0" y="0" width={w} height={h}>
      <g fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round">
        {timed.map(({ seg, d, t }) => <path d={seg.d} stroke-width={seg.w} pathLength="1" style={`--d: ${d}ms; --t: ${t}ms`} />)}
      </g>
      <rect class="mark-lift" width={w} height={h} fill="#fff" style={`--d: ${end}ms`} />
    </mask>
  </defs>
  <g transform={turn}>
    <image href={`/marks/${name}.svg`} width={w} height={h} mask={`url(#${id})`} />
  </g>
</svg>
