---
// FRAMES and CODE with drips that land on the 7/12 and 9/12 grid lines.
// Positions are copied from the canvas board "Home". Plays once, under 1.5 seconds.
interface Drip {
  left: string;
  top: string;
  width: number;
  height: string;
  delay: number;
  dur: number;
  shape: string;
  bulb: [number, number];
}

const desk: Drip[] = [
  { left: 'calc(45.617cqw - 3px)', top: '12.496cqw', width: 6, height: '2.752cqw', delay: 520, dur: 398, bulb: [10, 11], shape: '0% 0%, 100% 0%, 100% 6%, 91% 18%, 83% 34%, 87% 50%, 88% 66%, 90% 82%, 77% 100%, 13% 100%, 26% 82%, 21% 66%, 19% 50%, 8% 34%, 19% 18%, 0% 6%' },
  { left: 'calc((100cqw - 2px) * 0.583333 + 0.5px - 3px)', top: '12.600cqw', width: 6, height: '4.900cqw', delay: 560, dur: 428, bulb: [10, 11], shape: '0% 0%, 100% 0%, 100% 6%, 84% 18%, 87% 34%, 86% 50%, 79% 66%, 80% 82%, 79% 100%, 24% 100%, 11% 82%, 27% 66%, 28% 50%, 25% 34%, 28% 18%, 0% 6%' },
  { left: 'calc((100cqw - 2px) * 0.75 + 1.5px - 3px)', top: '15.301cqw', width: 6, height: '2.199cqw', delay: 840, dur: 390, bulb: [10, 11], shape: '0% 0%, 100% 0%, 100% 6%, 89% 18%, 89% 34%, 87% 50%, 73% 66%, 84% 82%, 88% 100%, 20% 100%, 14% 82%, 20% 66%, 14% 50%, 21% 34%, 25% 18%, 0% 6%' },
  { left: 'calc(100cqw * 0.833333 - 3px)', top: '14.075cqw', width: 6, height: '1.884cqw', delay: 890, dur: 386, bulb: [10, 11], shape: '0% 0%, 100% 0%, 100% 6%, 73% 18%, 78% 34%, 90% 50%, 80% 66%, 88% 82%, 77% 100%, 21% 100%, 20% 82%, 26% 66%, 27% 50%, 10% 34%, 15% 18%, 0% 6%' },
];

const phone: Drip[] = [
  { left: 'calc((100cqw - 3px) * 0.25 + 0.5px - 2px)', top: '15.247cqw', width: 4, height: '14.852cqw', delay: 560, dur: 434, bulb: [8, 9], shape: '0% 0%, 100% 0%, 100% 6%, 81% 18%, 80% 34%, 90% 50%, 86% 66%, 85% 82%, 80% 100%, 17% 100%, 25% 82%, 21% 66%, 23% 50%, 10% 34%, 25% 18%, 0% 6%' },
  { left: 'calc((100cqw - 3px) * 0.75 + 2.5px - 2px)', top: '30.373cqw', width: 4, height: '5.776cqw', delay: 840, dur: 388, bulb: [8, 9], shape: '0% 0%, 100% 0%, 100% 6%, 87% 18%, 85% 34%, 90% 50%, 87% 66%, 77% 82%, 86% 100%, 13% 100%, 17% 82%, 18% 66%, 20% 50%, 16% 34%, 11% 18%, 0% 6%' },
];

const dripStyle = (d: Drip) =>
  `left: ${d.left}; top: ${d.top}; width: ${d.width}px; height: ${d.height}; --op-delay: ${d.delay}ms; --op-dur: ${d.dur}ms; --op-from: -${d.height}`;
const bulbStyle = (d: Drip) =>
  `bottom: -${d.bulb[0] / 2}px; width: ${d.bulb[0]}px; height: ${d.bulb[1]}px; margin-left: -${d.bulb[0] / 2}px`;
---

<div class="op-hero" aria-hidden="true">
  <div class="op-only-desk">
    <img class="op-hero-tag" src="/marks/frames.svg" alt="" width="2208" height="1083" style="left: 29.919cqw; top: -0.55cqw; height: 15.4cqw; animation-duration: 520ms" />
    <img class="op-hero-tag" src="/marks/code.svg" alt="" width="1931" height="1062" style="left: 63.716cqw; top: 2.3cqw; height: 13.6cqw; animation-delay: 400ms; animation-duration: 420ms" />
    {
      desk.map((d) => (
        <div class="op-dripwrap" style={dripStyle(d)}>
          <div class="op-drip" style={`clip-path: polygon(${d.shape})`} />
          <div class="op-bulb" style={bulbStyle(d)} />
        </div>
      ))
    }
  </div>
  <div class="op-only-phone">
    <img class="op-hero-tag" src="/marks/frames.svg" alt="" width="2208" height="1083" style="left: 4cqw; top: -1cqw; height: 23cqw; animation-duration: 520ms" />
    <img class="op-hero-tag" src="/marks/code.svg" alt="" width="1931" height="1062" style="left: 61.453cqw; top: 13.5cqw; height: 19cqw; animation-delay: 400ms; animation-duration: 420ms" />
    {
      phone.map((d) => (
        <div class="op-dripwrap" style={dripStyle(d)}>
          <div class="op-drip" style={`clip-path: polygon(${d.shape})`} />
          <div class="op-bulb" style={bulbStyle(d)} />
        </div>
      ))
    }
  </div>
</div>
