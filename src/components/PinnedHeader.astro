---
// Slides in once the page's own header has scrolled out of view (see scripts/site.ts).
import CompactHeader from './CompactHeader.astro';
import type { Lang, PageKey } from '../lib/site';

interface Props {
  lang: Lang;
  page: PageKey;
}

const { lang, page } = Astro.props;
---

<div class="op-pin" data-op-pin>
  <div class="op-page">
    <CompactHeader lang={lang} page={page} />
  </div>
</div>
