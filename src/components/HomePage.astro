---
// The home page, in either language: software first, then the films.
import Base from '../layouts/Base.astro';
import Mark from './Mark.astro';
import Rows from './Rows.astro';
import GitHubMark from './GitHubMark.astro';
import LogoFrame from './LogoFrame.astro';
import Footer from './Footer.astro';
import { films } from '../data/films';
import { media, path, strings, timecode, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings(lang);
const h = t.home;
const hop = films.hoplite;
const bri = films.bridgemind;
const zero = timecode(0);
---

<Base lang={lang} page="home" title={t.meta.homeTitle} description={t.meta.homeDescription} og="home">
  <div class="op-page">
    <main id="main">
      <div class="cells edge">
        <div class="op-hero">
          <h1 class="op-name"><span>oskar</span> <span>pajka</span></h1>
          <div class="op-hero-tags" aria-hidden="true">
            <Mark name="code" play="load" dur={1000} delay={200} class="op-tag-code" />
            <Mark name="frames" play="load" dur={1250} delay={1300} class="op-tag-frames" />
          </div>
        </div>

        <div class="op-intro">
          <div class="cell op-intro-main">
            <p class="op-lede">{h.lede}</p>
            <div class="op-ctas">
              <a class="btn" href="#software">{h.ctaSoftware}</a>
              <a class="btn btn-quiet" href="#films">{h.ctaFilms}</a>
            </div>
          </div>
          <div class="cell">
            <dl class="t-data op-where">
              <dt class="t-muted">{h.basedInLabel}</dt>
              <dd>{h.basedIn}</dd>
              <dt class="t-muted">{h.openToLabel}</dt>
              <dd>{h.openTo}</dd>
            </dl>
          </div>
        </div>
      </div>

      <section id="software" class="cells edge" aria-labelledby="software-h">
        <div class="section-head">
          <h2 id="software-h" class="t-h2">{h.software}</h2>
        </div>

        <div class="op-work">
          <article class="op-blk op-blk-text-first" aria-labelledby="sw-h">
            <div class="op-k-text">
              <h3 id="sw-h" class="op-k-name t-card">Slotwise</h3>
              <div class="op-k-rowswrap">
                <Rows rows={h.slotwise.rows} />
              </div>
              <p class="op-k-para t-copy">{h.slotwise.para}</p>
              <a class="op-k-link btn btn-quiet" href="https://github.com/oskarpajka/slotwise" rel="noopener"><GitHubMark />{h.slotwise.link}<span class="visually-hidden">: Slotwise</span></a>
            </div>
            <div class="op-k-media">
              <LogoFrame id="slotwise">
                {/* Placeholder until the Slotwise logo exists. */}
                <span class="op-logo-word">slotwise</span>
              </LogoFrame>
            </div>
          </article>

          <article class="op-blk op-blk-media-first" aria-labelledby="fc-h">
            <div class="op-k-media">
              <LogoFrame id="framecatch">
                <img src="/images/framecatch-logo.webp" alt={h.framecatch.logoAlt} width="1000" height="123" loading="lazy" decoding="async" />
              </LogoFrame>
            </div>
            <div class="op-k-text">
              <h3 id="fc-h" class="op-k-name t-card">framecatch</h3>
              <div class="op-k-rowswrap">
                <Rows rows={h.framecatch.rows} links={{ 2: 'https://github.com/Explosivera' }} />
              </div>
              <p class="op-k-para t-copy">{h.framecatch.para}</p>
              <a class="op-k-link btn btn-quiet" href="https://github.com/Common-Branch/framecatch" rel="noopener"><GitHubMark />{h.framecatch.link}<span class="visually-hidden">: framecatch</span></a>
            </div>
          </article>
        </div>
      </section>

      <section id="films" class="cells edge" aria-labelledby="films-h">
        <div class="section-head">
          <h2 id="films-h" class="t-h2">{h.films}</h2>
        </div>

        <div class="op-work">
          <article class="op-blk op-blk-film-right" aria-labelledby="hop-h">
            <div class="op-k-text op-sticky">
              <h3 id="hop-h" class="op-k-name t-card">Hoplite</h3>
              <div class="op-k-rowswrap">
                <Rows rows={h.hoplite.rows} />
              </div>
              <p class="op-k-para t-copy">{h.hoplite.para}</p>
              <a class="op-k-link btn btn-ink" href={path('hoplite', lang)}>{h.viewProject}<span class="visually-hidden">: Hoplite</span></a>
            </div>
            <div class="op-k-media">
              <div class="op-film" style={`aspect-ratio: ${hop.ratio}`}>
                <video
                  data-op-loop
                  src={media(hop.loop)}
                  poster={hop.poster}
                  muted
                  loop
                  playsinline
                  preload="none"
                  tabindex="0"
                  aria-label={h.hoplite.videoLabel}
                  width="1280"
                  height="720"></video>
                <span class="chip" aria-hidden="true"><span data-op-tc>{zero}</span><span class="t-muted"> / {timecode(hop.frames)}</span></span>
              </div>
            </div>
          </article>

          <article class="op-blk op-blk-media-first" aria-labelledby="bri-h">
            <div class="op-k-media">
              <div class="op-film" style={`aspect-ratio: ${bri.ratio}`}>
                <video
                  data-op-loop
                  src={media(bri.loop)}
                  poster={bri.poster}
                  muted
                  loop
                  playsinline
                  preload="none"
                  tabindex="0"
                  aria-label={h.bridgemind.videoLabel}
                  width="720"
                  height="720"></video>
                <span class="chip" aria-hidden="true"><span data-op-tc>{zero}</span><span class="t-muted"> / {timecode(bri.frames)}</span></span>
              </div>
            </div>
            <div class="op-k-text op-sticky">
              <h3 id="bri-h" class="op-k-name t-card">BridgeMind</h3>
              <div class="op-k-rowswrap">
                <Rows rows={h.bridgemind.rows} />
              </div>
              <p class="op-k-para t-copy">{h.bridgemind.para}</p>
              <a class="op-k-link btn btn-ink" href={path('bridgemind', lang)}>{h.viewProject}<span class="visually-hidden">: BridgeMind</span></a>
            </div>
          </article>
        </div>
      </section>

      <section id="about" class="cells edge" aria-labelledby="about-h">
        <div class="section-head">
          <h2 id="about-h" class="t-h2">{h.about}</h2>
        </div>
        <div class="cell op-about">
          <p class="op-statement">{h.statement}</p>
        </div>
        <div class="row op-facts">
          {
            h.facts.map(([k, v]) => (
              <div class="cell">
                <span class="t-data t-muted">{k}</span>
                <span class="v">{v}</span>
              </div>
            ))
          }
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</Base>
