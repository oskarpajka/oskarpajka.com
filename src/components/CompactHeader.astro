---
// The header with the name: on project pages, Privacy and 404, and pinned after scrolling.
import { path, strings, type Lang, type PageKey } from '../lib/site';

interface Props {
  lang: Lang;
  page: PageKey;
  id?: string;
  edge?: boolean;
}

const { lang, page, id, edge } = Astro.props;
const t = strings(lang);
const home = path('home', lang);
const onHome = page === 'home';
const hasFooter = page === 'home' || page === 'hoplite' || page === 'bridgemind';
const other = t.otherLang as Lang;
---

<header id={id} class:list={['op-chead', { 'edge-b': edge }]}>
  <a class="op-nav op-name" href={onHome ? '#top' : home}>oskar pajka</a>
  <nav class="op-navs" aria-label={t.nav.label}>
    <a class="op-nav" href={onHome ? '#work' : `${home}#work`}>{t.nav.work}</a>
    <a class="op-nav" href={onHome ? '#about' : `${home}#about`}>{t.nav.about}</a>
    <a class="op-nav" href={hasFooter ? '#contact' : `${home}#contact`}>{t.nav.contact}</a>
    <a class="op-nav op-lang" href={path(page, other)} hreflang={other} lang={other} aria-label={t.otherName}>{t.otherLabel}</a>
  </nav>
</header>
