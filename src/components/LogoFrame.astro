---
// A product's logo on a light board inside a dashed selection frame with orange
// corner handles. The frame draws itself when it comes into view.
interface Props {
  id: string; // unique on the page, for the frame's mask
}

const { id } = Astro.props;
const mask = `op-sel-mask-${id}`;
---

<div class="op-sel" data-op-reveal="sel">
  <div class="op-sel-box">
    <slot />
  </div>
  <svg class="op-sel-svg" aria-hidden="true">
    <defs>
      <mask id={mask} maskUnits="userSpaceOnUse" x="-20" y="-20" width="4000" height="4000">
        <rect class="op-sel-draw" x="0" y="0" width="100%" height="100%" pathLength="1" fill="none" stroke="#fff" stroke-width="6"></rect>
      </mask>
    </defs>
    <rect x="0.5" y="0.5" width="100%" height="100%" fill="none" stroke="#111110" stroke-width="1" stroke-dasharray="6 4" mask={`url(#${mask})`}></rect>
  </svg>
  <div class="op-sel-hs" aria-hidden="true">
    <span class="op-sel-h"></span><span class="op-sel-h"></span><span class="op-sel-h"></span><span class="op-sel-h"></span>
  </div>
</div>
