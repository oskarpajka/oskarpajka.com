---
// Page not found: the LOST tag, no contact footer.
import Base from '../layouts/Base.astro';
import Mark from './Mark.astro';
import SmallFooter from './SmallFooter.astro';
import { path, strings, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings(lang);
---

<Base lang={lang} page="notFound" title={t.meta.notFoundTitle}>
  <div class="op-page">
    <main id="main" class="cells edge op-boxed">
      <div class="op-lost">
        <Mark name="lost" play="load" dur={1200} delay={150} label={t.notFound.tagAlt} />
        <div>
          <h1>{t.notFound.text}</h1>
          <a class="btn btn-ink" href={path('home', lang)}>{t.footer.home}</a>
        </div>
      </div>
    </main>
    <SmallFooter href={path('privacy', lang)} label={t.footer.privacy} />
  </div>
</Base>
