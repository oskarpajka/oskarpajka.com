---
// Contact footer with the OSKAR tag: home and project pages.
import Mark from './Mark.astro';
import { EMAIL, path, strings, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = strings(lang);
const [user, domain] = EMAIL.split('@');
const links = [
  ['GitHub', 'https://github.com/oskarpajka'],
  ['LinkedIn', 'https://www.linkedin.com/in/oskarpajka/'],
  ['X', 'https://x.com/oskarpajka'],
  ['Instagram', 'https://www.instagram.com/oska.rpajka/'],
];
---

<div class="op-footrule" aria-hidden="true"></div>
<footer id="contact" class="op-footer">
  <div class="op-tagclip" aria-hidden="true">
    <Mark name="oskar-wide" order="letters" dur={420} stagger={85} class="op-tag-wide" />
    <Mark name="oskar-wide" tall order="letters" dur={420} stagger={85} class="op-tag-tall" />
  </div>
  <div class="op-foot">
    <div class="op-contact">
      <div class="op-contact-main">
        <h2 class="t-h2">{t.footer.contact}</h2>
        <div class="op-mailrow">
          <div class="op-mailwrap" data-op-mail data-copied="0">
            <Mark name="circle" play="manual" dur={420} stretch class="op-circle" />
            <button class="op-email" type="button" data-op-copy={EMAIL} aria-label={t.footer.copyLabel}>{user}@<wbr />{domain}</button>
            <Mark name="check" play="manual" dur={260} class="op-check" />
          </div>
          <span class="t-data t-muted" aria-live="polite" data-op-copy-label data-copy={t.footer.copy} data-copied={t.footer.copied}>{t.footer.copy}</span>
        </div>
      </div>
      <nav class="op-elsewhere" aria-label={t.footer.elsewhere}>
        {links.map(([label, href]) => <a class="link link-control" href={href} rel="me noopener">{label}</a>)}
        <a class="link link-control" href="/cv/Oskar-Pajka-CV.pdf">{t.footer.cv}</a>
      </nav>
    </div>
    <div class="op-footline t-data">
      <span>© 2026 Oskar Pajka</span>
      <div>
        <a class="link" href={path('privacy', lang)}>{t.footer.privacy}</a>
        <a class="link" href="#top">{t.footer.top}</a>
      </div>
    </div>
  </div>
</footer>
