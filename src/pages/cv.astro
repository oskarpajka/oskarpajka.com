---
// The CV as an A4 print page. Not linked from the site. `npm run cv` prints it to public/cv/Oskar-Pajka-CV.pdf.
// Content lives in src/data/cv.json; this file is layout only. A plain, conventional
// one-column CV: one typeface (Source Sans 3), black text, nothing from the site's design.
import raw from '../data/cv.json';
import { parseCv } from '../data/cv.schema.mjs';

const cv = parseCv(raw);
const projects = cv.projects.filter((item) => item.show);
const href = (link: string) => (/^https?:\/\//.test(link) ? link : `https://${link}`);
const unicodeRanges = {
  latin: 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD',
  'latin-ext': 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF',
};
// Static weights, so the PDF embeds real fonts, not Type3.
const fontFaces = Object.entries(unicodeRanges)
  .flatMap(([subset, unicodeRange]) =>
    [400, 600, 700].map(
      (weight) =>
        `@font-face { font-family: 'Source Sans 3'; font-style: normal; font-weight: ${weight}; src: url('/fonts/cv/source-sans-3-${subset}-${weight}.woff2') format('woff2'); unicode-range: ${unicodeRange}; }`,
    ),
  )
  .join('\n');
const range = (from: string, to: string) => (from === to ? from : `${from} – ${to === 'present' ? 'Present' : to}`);
const contact = [
  { text: cv.location },
  { text: cv.email, href: `mailto:${cv.email}` },
  ...(cv.phone ? [{ text: cv.phone, href: `tel:${cv.phone.replace(/\s/g, '')}` }] : []),
  { text: cv.website, href: href(cv.website) },
  { text: cv.github, href: href(cv.github) },
  { text: cv.linkedin, href: href(cv.linkedin) },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="author" content={cv.name} />
    <title>{cv.name}, CV</title>
    <link rel="preload" href="/fonts/cv/source-sans-3-latin-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page">
      <header>
        <h1>{cv.name}</h1>
        <p class="headline">{cv.headline}</p>
        <p class="contact">
          {contact.map((c) => (c.href ? <a href={c.href}>{c.text}</a> : <span>{c.text}</span>))}
        </p>
      </header>

      <main>
        <section>
          <h2>Summary</h2>
          <p>{cv.summary}</p>
        </section>

        {cv.experience.length > 0 && (
          <section>
            <h2>Experience</h2>
            {cv.experience.map((item) => (
              <article>
                <div class="line">
                  <h3>{item.role}, <span class="normal">{item.organisation}</span></h3>
                  <span class="date">{range(item.from, item.to)}</span>
                </div>
                <ul>{item.points.map((p) => <li>{p}</li>)}</ul>
              </article>
            ))}
          </section>
        )}

        {projects.length > 0 && (
          <section>
            <h2>Projects</h2>
            {projects.map((item) => (
              <article>
                <div class="line">
                  <h3>{item.name} <span class="normal">| {item.kind}</span></h3>
                  <span class="date">{range(item.from, item.to)}</span>
                </div>
                <p class="meta">
                  {item.stack.join(', ')} | <a href={href(item.link)}>{item.link}</a>
                </p>
                <ul>{item.points.map((p) => <li>{p}</li>)}</ul>
              </article>
            ))}
          </section>
        )}

        <section>
          <h2>Skills</h2>
          {cv.skills.map((group) => (
            <p class="pair"><strong>{group.label}:</strong> {group.items.join(', ')}</p>
          ))}
        </section>

        {cv.education.length > 0 && (
          <section>
            <h2>Education</h2>
            {cv.education.map((item) => (
              <article>
                <div class="line">
                  <h3>{item.school}</h3>
                  <span class="date">{range(item.from, item.to)}</span>
                </div>
                <p>{item.programme}</p>
              </article>
            ))}
          </section>
        )}

        {cv.awards.length > 0 && (
          <section>
            <h2>Awards</h2>
            {cv.awards.map((item) => (
              <div class="line">
                <p>{item.title}</p>
                <span class="date">{item.year}</span>
              </div>
            ))}
          </section>
        )}

        <section>
          <h2>Languages</h2>
          <p>{cv.languages.map((item) => `${item.language} (${item.level})`).join(', ')}</p>
        </section>
      </main>

      {cv.gdprClause.show && <footer lang="pl">{cv.gdprClause.text}</footer>}
    </div>
  </body>
</html>

<style is:global set:html={fontFaces}></style>
<style is:global>
  @page {
    size: A4;
    margin: 16mm 18mm 15mm;
  }

  :root {
    --ink: #000;
    --secondary: #444;
    /* A4 height minus the @page margins. build-cv.mjs reads this to detect overflow. */
    --content-height: 266mm;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: #fff;
    color: var(--ink);
    font-family: 'Source Sans 3', Arial, sans-serif;
    font-size: 10pt;
    line-height: 1.3;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* On screen, show the sheet at print width so the preview matches the PDF. */
  @media screen {
    body {
      max-width: calc(210mm - 36mm);
      margin: 16mm auto;
    }
  }

  .page {
    display: flex;
    flex-direction: column;
    /* A hair under the printable height, so a full page never rounds onto a second one. */
    min-height: calc(var(--content-height) - 1mm);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  header {
    text-align: center;
    padding-bottom: 3mm;
  }

  h1 {
    font-size: 22pt;
    font-weight: 700;
    line-height: 1.1;
  }

  .headline {
    font-size: 11.5pt;
    margin-top: 0.5mm;
  }

  .contact {
    margin-top: 1.5mm;
    font-size: 9.5pt;
    color: var(--secondary);
  }

  .contact > * {
    white-space: nowrap;
  }

  .contact > * + *::before {
    content: '|';
    margin: 0 2mm;
    color: #999;
  }

  section {
    margin-top: 3mm;
    break-inside: avoid;
  }

  h2 {
    font-size: 10.5pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border-bottom: 0.75pt solid var(--ink);
    padding-bottom: 0.6mm;
    margin-bottom: 1.8mm;
  }

  article + article {
    margin-top: 2.2mm;
  }

  .line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 4mm;
  }

  h3 {
    font-size: 10pt;
    font-weight: 700;
  }

  .normal {
    font-weight: 400;
  }

  .date {
    flex: 0 0 auto;
    font-size: 9.5pt;
  }

  .meta {
    font-size: 9pt;
    color: var(--secondary);
  }

  ul {
    margin-top: 0.6mm;
    padding-left: 4.5mm;
  }

  li + li {
    margin-top: 0.4mm;
  }

  .pair + .pair {
    margin-top: 0.4mm;
  }

  footer {
    margin-top: auto;
    padding-top: 4mm;
    font-size: 7.5pt;
    line-height: 1.3;
    color: var(--secondary);
  }
</style>
