---
// The CV as an A4 print page. Not linked from the site. `npm run cv` prints it to public/cv/Oskar-Pajka-CV.pdf.
// Content lives in src/data/cv.json; this file is layout only.
import raw from '../data/cv.json';
import { parseCv } from '../data/cv.schema.mjs';

const cv = parseCv(raw);
const work = cv.work.filter((item) => item.show);
const href = (link: string) => (/^https?:\/\//.test(link) ? link : `https://${link}`);
// One @font-face per static cut (width %, weight) and character subset.
const unicodeRanges = {
  latin: 'U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD',
  'latin-ext': 'U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF',
};
const cuts = [[100, 400], [100, 600], [125, 600], [125, 700]];
const fontFaces = Object.entries(unicodeRanges)
  .flatMap(([subset, unicodeRange]) =>
    cuts.map(
      ([width, weight]) =>
        `@font-face { font-family: 'Archivo'; font-style: normal; font-weight: ${weight}; font-stretch: ${width}%; src: url('/fonts/cv/archivo-${subset}-${width}-${weight}.woff2') format('woff2'); unicode-range: ${unicodeRange}; }`,
    ),
  )
  .join('\n');
const range = (from: string, to: string) => (from === to ? from : `${from} to ${to}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="author" content={cv.name} />
    <title>{cv.name}, CV</title>
    <link rel="preload" href="/fonts/cv/archivo-latin-100-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="page">
      <header>
        <h1>{cv.name}</h1>
        <p class="role">{cv.role}. <span class="secondary">{cv.location}.</span></p>
        <p class="contact">
          <a href={`mailto:${cv.email}`}>{cv.email}</a>{' '}
          <a href={href(cv.website)}>{cv.website}</a>{' '}
          <a href={href(cv.linkedin)}>{cv.linkedin}</a>{' '}
          <a href={href(cv.github)}>{cv.github}</a>
        </p>
      </header>

      <main>
        <section>
          <h2>Profile</h2>
          <div><p>{cv.profile}</p></div>
        </section>

        {work.length > 0 && (
          <section>
            <h2>Selected work</h2>
            <div class="items">
              {work.map((item) => (
                <article>
                  <h3>{item.title}<span class="secondary">, {item.type}, {item.year}</span></h3>
                  <p>{item.oneLine}</p>
                  <p class="secondary">
                    {item.tools.join(', ')}. <a href={href(item.link)}>{item.link}</a>
                  </p>
                </article>
              ))}
            </div>
          </section>
        )}

        {cv.experience.length > 0 && (
          <section>
            <h2>Experience</h2>
            <div class="items">
              {cv.experience.map((item) => (
                <article>
                  <h3>{item.role}<span class="secondary">, {item.organisation}, {range(item.from, item.to)}</span></h3>
                  <p>{item.oneLine}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        <section>
          <h2>Skills</h2>
          <div class="items">
            <p><span class="sublabel">Motion and design:</span> {cv.skills.motion.join(', ')}</p>
            <p><span class="sublabel">Code:</span> {cv.skills.code.join(', ')}</p>
          </div>
        </section>

        {cv.education.length > 0 && (
          <section>
            <h2>Education</h2>
            <div class="items">
              {cv.education.map((item) => (
                <article>
                  <h3>{item.school}<span class="secondary">, {range(item.from, item.to)}</span></h3>
                  <p>{item.programme}</p>
                </article>
              ))}
            </div>
          </section>
        )}

        {cv.awards.length > 0 && (
          <section>
            <h2>Awards</h2>
            <div class="items">
              {cv.awards.map((item) => (
                <p>{item.title}<span class="secondary">, {item.year}</span></p>
              ))}
            </div>
          </section>
        )}

        <section>
          <h2>Languages</h2>
          <div class="items">
            {cv.languages.map((item) => (
              <p><span class="sublabel">{item.language}:</span> {item.level}</p>
            ))}
          </div>
        </section>
      </main>

      {cv.gdprClause.show && <footer lang="pl">{cv.gdprClause.text}</footer>}
    </div>
  </body>
</html>

<style is:global set:html={fontFaces}></style>
<style is:global>
  /* Static Archivo cuts from scripts/make-cv-fonts.py, so the PDF embeds real fonts, not Type3. */
  @page {
    size: A4;
    margin: 18mm 18mm 16mm;
  }

  :root {
    --ink: #111110;
    --secondary: #55554f;
    --rule: 0.5pt solid var(--ink);
    --label: 38mm;
    /* A4 height minus the @page margins. build-cv.mjs reads this to detect overflow. */
    --content-height: 263mm;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: #fff;
    color: var(--ink);
    font-family: 'Archivo', sans-serif;
    font-size: 10pt;
    font-stretch: 100%;
    line-height: 1.35;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  /* On screen, show the sheet at print width so the preview matches the PDF. */
  @media screen {
    body {
      max-width: calc(210mm - 36mm);
      margin: 18mm auto;
    }
  }

  .page {
    display: flex;
    flex-direction: column;
    /* A hair under the printable height, so a full page never rounds onto a second one. */
    min-height: calc(var(--content-height) - 1mm);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .secondary {
    color: var(--secondary);
  }

  header {
    padding-bottom: 5mm;
  }

  h1 {
    font-size: 26pt;
    font-stretch: 125%;
    font-weight: 700;
    line-height: 1;
    text-transform: lowercase;
    letter-spacing: -0.01em;
    margin-bottom: 3mm;
  }

  .role {
    margin-bottom: 1mm;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    column-gap: 5mm;
  }

  section {
    display: grid;
    grid-template-columns: var(--label) 1fr;
    border-top: var(--rule);
    padding: 3mm 0 3.5mm;
    break-inside: avoid;
  }

  h2 {
    font-size: 9pt;
    font-stretch: 125%;
    font-weight: 600;
    line-height: 1.5;
  }

  h3 {
    font-size: 10pt;
    font-weight: 600;
  }

  h3 .secondary {
    font-weight: 400;
  }

  .sublabel {
    font-weight: 600;
  }

  .items {
    display: flex;
    flex-direction: column;
    gap: 1.2mm;
  }

  .items article + article {
    margin-top: 1.3mm;
  }

  footer {
    margin-top: auto;
    padding-top: 4mm;
    font-size: 7pt;
    line-height: 1.3;
    color: var(--secondary);
  }
</style>
